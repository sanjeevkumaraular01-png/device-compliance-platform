# =============================================================================
#  SecureEndpoint Manager — environment configuration
# =============================================================================
#  Copy to `.env` and fill in, or generate one with strong random secrets:
#      ./scripts/generate-secrets.sh          (Linux / macOS / Git Bash)
#      .\scripts\generate-secrets.ps1         (Windows PowerShell)
#
#  Values marked __GENERATE_*__ are replaced automatically by those scripts.
#  To generate by hand:
#      __GENERATE_BASE64_32__   -> openssl rand -base64 32
#      __GENERATE_BASE64_48__   -> openssl rand -base64 48
#      __GENERATE_HEX_24__      -> openssl rand -hex 24
#
#  NEVER commit `.env`. Treat ENCRYPTION_KEY and the /data/pki CA key as
#  crown jewels: losing ENCRYPTION_KEY makes MFA secrets, alert-channel
#  configs and license keys unreadable; leaking it exposes them.
#  Full reference: docs/ENVIRONMENT.md
# =============================================================================

# -----------------------------------------------------------------------------
#  Compose-only settings (consumed by docker-compose.yml, not by the backend)
# -----------------------------------------------------------------------------
# Public DNS name of the deployment (used to build WEB_URL etc. below and for TLS).
DOMAIN=localhost
# Compose project name (prefix for containers/volumes).
COMPOSE_PROJECT_NAME=secureendpoint
# Image registry/tag used when building or pulling images.
IMAGE_REGISTRY=ghcr.io/secureendpoint/secureendpoint-manager
IMAGE_TAG=latest
# Host interface/ports Nginx publishes.
HTTP_PORT=80
HTTPS_PORT=443
# Directory (on the host) containing fullchain.pem + privkey.pem for Nginx.
# Generate a self-signed pair for local use: ./scripts/gen-self-signed-cert.sh
TLS_CERT_DIR=./deploy/nginx/certs

# PostgreSQL (container). Password must be URL-safe (hex) because it is
# embedded in DATABASE_URL.
POSTGRES_USER=sem
POSTGRES_PASSWORD=__GENERATE_HEX_24__
POSTGRES_DB=secureendpoint

# Redis (container). URL-safe (hex) — embedded in REDIS_URL.
REDIS_PASSWORD=__GENERATE_HEX_24__

# Monitoring profile (docker compose --profile monitoring up -d)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE_HEX_24__
# Host interface Grafana/Prometheus/Alertmanager bind to (keep loopback; tunnel via SSH).
MONITORING_BIND=127.0.0.1

# -----------------------------------------------------------------------------
#  Backend — core
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# api | worker | all  (compose sets this per service; leave as-is)
APP_ROLE=all
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Connection strings. In docker compose these are derived automatically from
# POSTGRES_* / REDIS_PASSWORD — only set them to point at external/managed
# services (e.g. RDS / Azure Cache for Redis). Include ?sslmode=require for managed PG.
# DATABASE_URL=postgresql://sem:password@db.example.com:5432/secureendpoint?schema=public&sslmode=require
# REDIS_URL=rediss://:password@redis.example.com:6380/0

# -----------------------------------------------------------------------------
#  Backend — security
# -----------------------------------------------------------------------------
# HS256 signing secret for access tokens, >= 32 chars.   openssl rand -base64 48
JWT_ACCESS_SECRET=__GENERATE_BASE64_48__
# Access-token lifetime in seconds (15 min).
JWT_ACCESS_TTL=900
# Rotating refresh-token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=7
# AES-256-GCM field-encryption key: base64 of EXACTLY 32 random bytes.  openssl rand -base64 32
# Rotating it requires re-encrypting data — see docs/RUNBOOK.md.
ENCRYPTION_KEY=__GENERATE_BASE64_32__
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=https://localhost
# Public URL of the admin console (SSO callbacks redirect here).
WEB_URL=https://localhost
# Public base URL of the API (used in install one-liners and SSO redirect URIs).
API_PUBLIC_URL=https://localhost/api/v1
# Trust X-Forwarded-* from the reverse proxy (Nginx / Ingress). Keep true behind a proxy.
TRUST_PROXY=true
# Global rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_TTL seconds per client.
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
# Stricter limit for /auth endpoints (per RATE_LIMIT_TTL window).
AUTH_RATE_LIMIT_MAX=10
# Roles that must enrol MFA (comma-separated RoleKey values).
SECURITY_MFA_REQUIRED_ROLES=SUPER_ADMIN,SECURITY_ADMIN
# Console session idle timeout.
SESSION_IDLE_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
#  Backend — storage (shared volume between api and worker)
# -----------------------------------------------------------------------------
REPORTS_DIR=/data/reports
# Internal device CA. Generated on first start if missing. BACK UP /data/pki!
CA_CERT_PATH=/data/pki/ca.crt
CA_KEY_PATH=/data/pki/ca.key
# Where install scripts download agent binaries from (served by Nginx /downloads/).
AGENT_DOWNLOAD_BASE_URL=https://localhost/downloads

# -----------------------------------------------------------------------------
#  Seed (first start only; the api service runs it when RUN_SEED=true)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@secureendpoint.local
# Change after first login (or set a strong value here before first start).
SEED_ADMIN_PASSWORD=ChangeMe!Secure2026
# Creates demo departments, devices and one user per role. Set false in production.
SEED_DEMO_DATA=true

# -----------------------------------------------------------------------------
#  Email (SMTP) — alert channel EMAIL, scheduled reports
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS upgrade (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SecureEndpoint Manager <no-reply@example.com>"

# -----------------------------------------------------------------------------
#  Twilio — alert channels SMS and WHATSAPP
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number, e.g. +15551234567
TWILIO_FROM_NUMBER=
# WhatsApp-enabled sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# -----------------------------------------------------------------------------
#  LDAP / Active Directory login (POST /auth/ldap/login) — leave LDAP_URL empty to disable
# -----------------------------------------------------------------------------
# Use ldaps://dc01.corp.example.com:636 in production.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
# {{username}} is replaced with the login name. OpenLDAP: (uid={{username}})
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_DEFAULT_ROLE=EMPLOYEE
# JSON map of directory group -> RoleKey, e.g.
# {"CN=SEM-Admins,OU=Groups,DC=corp,DC=example,DC=com":"SUPER_ADMIN","CN=SEM-Auditors,OU=Groups,DC=corp,DC=example,DC=com":"AUDITOR"}
LDAP_GROUP_ROLE_MAP={}

# -----------------------------------------------------------------------------
#  Microsoft Entra ID (Azure AD) SSO — leave empty to disable
# -----------------------------------------------------------------------------
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://localhost/api/v1/auth/sso/azure-ad/callback
# JSON map of Entra group object ID -> RoleKey, e.g. {"3f2a...":"SECURITY_ADMIN"}
AZURE_AD_GROUP_ROLE_MAP={}

# -----------------------------------------------------------------------------
#  Generic OpenID Connect SSO (Okta, Keycloak, Auth0, Google...) — leave empty to disable
# -----------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost/api/v1/auth/sso/oidc/callback
