    {
      "id": 14,
      "type": "timeseries",
      "title": "USB storage blocks / min",
      "description": "Mass-storage devices blocked by the agent.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(sem_usb_blocked_total[$__rate_interval])) * 60",
          "legendFormat": "Blocked",
          "refId": "A",
          "range": true,
          "instant": false
