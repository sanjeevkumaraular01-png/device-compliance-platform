NODE_ENV=production
PORT=4000
LOG_LEVEL=info
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=https://sem.example.com
WEB_URL=https://sem.example.com
API_PUBLIC_URL=https://sem.example.com/api/v1
AGENT_DOWNLOAD_BASE_URL=https://sem.example.com/downloads
TRUST_PROXY=true
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
SECURITY_MFA_REQUIRED_ROLES=SUPER_ADMIN,SECURITY_ADMIN
SESSION_IDLE_TIMEOUT_MINUTES=30
REPORTS_DIR=/data/reports
CA_CERT_PATH=/data/pki/ca.crt
CA_KEY_PATH=/data/pki/ca.key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=SecureEndpoint Manager <no-reply@sem.example.com>
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
LDAP_URL=
LDAP_BIND_DN=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_DEFAULT_ROLE=EMPLOYEE
LDAP_GROUP_ROLE_MAP={}
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_REDIRECT_URI=https://sem.example.com/api/v1/auth/sso/azure-ad/callback
AZURE_AD_GROUP_ROLE_MAP={}
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=https://sem.example.com/api/v1/auth/sso/oidc/callback
SEED_ADMIN_EMAIL=admin@secureendpoint.local
SEED_DEMO_DATA=false
