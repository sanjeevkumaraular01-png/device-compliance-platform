# ─── SecureEndpoint Manager backend ─────────────────────────────────────
NODE_ENV=development
PORT=4000
# api = HTTP API only | worker = BullMQ processors + schedulers (health/metrics HTTP only) | all = both
APP_ROLE=all
LOG_LEVEL=info

# ─── Data stores ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sem:sem@localhost:5432/sem
REDIS_URL=redis://localhost:6379

# ─── Security ───────────────────────────────────────────────────────────
# >= 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
# base64 of exactly 32 bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY_xxxxxxxxxxxx=
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
TRUST_PROXY=true
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
SECURITY_MFA_REQUIRED_ROLES=SUPER_ADMIN,SECURITY_ADMIN
SESSION_IDLE_TIMEOUT_MINUTES=30

# ─── Email (optional; channel test returns 422 when unset) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SecureEndpoint Manager <no-reply@secureendpoint.local>

# ─── Twilio SMS / WhatsApp (optional) ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# ─── LDAP / Active Directory (optional) ─────────────────────────────────
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_DEFAULT_ROLE=EMPLOYEE
# JSON map group DN -> role key, e.g. {"CN=IT-Admins,OU=Groups,DC=corp,DC=local":"IT_ADMIN"}
LDAP_GROUP_ROLE_MAP=

# ─── Azure AD / Entra ID SSO (optional) ─────────────────────────────────
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:4000/api/v1/auth/sso/azure-ad/callback
# JSON map group object id -> role key
AZURE_AD_GROUP_ROLE_MAP=

# ─── Generic OIDC SSO (optional) ────────────────────────────────────────
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/sso/oidc/callback

# ─── Files / PKI / agent ────────────────────────────────────────────────
REPORTS_DIR=./data/reports
CA_CERT_PATH=./data/pki/ca.crt
CA_KEY_PATH=./data/pki/ca.key
AGENT_DOWNLOAD_BASE_URL=http://localhost/downloads

# ─── Bootstrap ──────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@secureendpoint.local
SEED_ADMIN_PASSWORD=ChangeMe!Secure2026
SEED_DEMO_DATA=true
RUN_MIGRATIONS=true
RUN_SEED=true

# ─── Workforce / AI work intelligence (docs/WORKFORCE.md, all optional) ──
# Encrypted (AES-256-GCM) screenshot storage; only used when a workforce policy enables screenshots.
SCREENSHOTS_DIR=./data/screenshots
# Organization time zone (AI nightly run, HRMS push, org-level "today").
WORKFORCE_TIMEZONE=Asia/Kolkata
# Claude API key; empty = AI insights disabled (endpoints return 422 "AI is not configured").
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=high
# Local time (WORKFORCE_TIMEZONE) of the nightly Message Batch run.
AI_DAILY_RUN_TIME=20:30
AI_MAX_EMPLOYEES_PER_RUN=500

# ── Self-service device enrollment (docs/DEPLOY-SELF-ENROLL.md), all optional ──
# Employees install the agent from https://DOMAIN/install by signing in with their
# company email (verified over IMAP). Leave DEPLOY_IMAP_HOST empty to disable.
DEPLOY_ENABLED=true
DEPLOY_COMPANY_NAME=Webyne
DEPLOY_IMAP_HOST=mail.webyne.com
DEPLOY_IMAP_PORT=993
DEPLOY_IMAP_SECURE=true
DEPLOY_ALLOWED_DOMAINS=webyne.com
DEPLOY_SESSION_TTL_MIN=20
DEPLOY_DOWNLOAD_BASE_URL=
